k*ō<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101114"
    android:fitsSystemWindows="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="#07131C">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="⚡ LIGHTNING MONITOR"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="100dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="● LIVE
REAL-TIME"
                android:textColor="#00E676"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="#10231D" />

        </LinearLayout>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="#17191D">

        <Button
            android:id="@+id/sfl8Button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="SFL8"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#30343A" />

        <Button
            android:id="@+id/sfl1Button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="SFL1"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#30343A" />

        <TextView
            android:id="@+id/alarmStatus"
            android:layout_width="42dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="🔔"
            android:textSize="18sp"
            android:background="#25282D" />

        <Button
            android:id="@+id/stopAlarmButton"
            android:layout_width="42dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:text="🔕"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#25282D" />

    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="38dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="10dp" android:background="#101114"><TextView android:id="@+id/lastEventText" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:text="⚡ Último evento: —" android:textColor="#FFFFFF" android:textSize="12sp"/><TextView android:id="@+id/updateText" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:text="🔄 Actualizado: —" android:textColor="#FFFFFF" android:textSize="12sp"/><TextView android:id="@+id/connectionText" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:text="🟢 Conectado" android:textColor="#FFFFFF" android:textSize="12sp"/></LinearLayout>
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF" />

</LinearLayout>
